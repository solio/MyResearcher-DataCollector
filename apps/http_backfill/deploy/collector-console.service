[Unit]
Description=HTTP backfill collector and console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=BACKFILL_API_ONLY=@API_ONLY@
Environment=BACKFILL_FLEET_SYNC_ENABLED=@FLEET_SYNC@
ExecStart=@PYTHON@ -B @SERVER@ --host @HOST@ --port @PORT@ --data-dir @DATA_DIR@
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=multi-user.target
