<?xml version="1.0" encoding="utf-8"?>
<!-- One activity drives a screen state machine, matching the ArkTS client's page
     layout: header, scrollable body with one container per screen, and a separate
     WebView area used only during verification. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/waygate_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/waygate_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/message_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:textColor="@color/waygate_ink"
                android:textSize="14sp" />

            <!-- loading -->
            <LinearLayout
                android:id="@+id/screen_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/state_loading"
                    android:textColor="@color/waygate_muted" />
            </LinearLayout>

            <!-- settings -->
            <LinearLayout
                android:id="@+id/screen_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_hub" />
                <EditText
                    android:id="@+id/hub_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_hub"
                    android:inputType="textUri" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_token" />
                <EditText
                    android:id="@+id/token_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/save_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_save" />

                <Button
                    android:id="@+id/channel_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_channel" />

                <Button
                    android:id="@+id/diagnostics_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_diagnostics" />
            </LinearLayout>

            <!-- home -->
            <LinearLayout
                android:id="@+id/screen_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sync_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/waygate_muted" />
                <TextView
                    android:id="@+id/notification_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/waygate_muted" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="@string/label_inbox"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/inbox_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="@string/label_nodes"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/nodes_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- node: import credentials, or test a channel -->
            <LinearLayout
                android:id="@+id/screen_node"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/node_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_node"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/node_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/waygate_muted" />
                <LinearLayout
                    android:id="@+id/node_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
                <EditText
                    android:id="@+id/node_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_node_host"
                    android:inputType="text" />
                <EditText
                    android:id="@+id/node_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_node_port"
                    android:inputType="number" />
                <EditText
                    android:id="@+id/node_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_node_user"
                    android:inputType="text" />

                <LinearLayout
                    android:id="@+id/node_auth_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioGroup
                        android:id="@+id/node_auth_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/node_auth_key"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/auth_key" />
                        <RadioButton
                            android:id="@+id/node_auth_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_password" />
                    </RadioGroup>
                </LinearLayout>

                <EditText
                    android:id="@+id/node_secret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_node_secret"
                    android:inputType="textMultiLine|textNoSuggestions" />
                <EditText
                    android:id="@+id/node_passphrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_node_passphrase"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/probe_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_probe" />
                <TextView
                    android:id="@+id/node_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/connect_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_connect" />
                <TextView
                    android:id="@+id/channel_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/node_back"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_back" />
            </LinearLayout>

            <!-- transition -->
            <LinearLayout
                android:id="@+id/screen_transition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- result of a submitted probe -->
            <LinearLayout
                android:id="@+id/screen_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/claim_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/resume_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_resume" />
                <Button
                    android:id="@+id/result_back"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_back" />
            </LinearLayout>

            <!-- diagnostics -->
            <LinearLayout
                android:id="@+id/screen_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/diagnostics_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/diagnostics_back"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_back" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- verification browser: hidden until the shared exit has been confirmed -->
    <LinearLayout
        android:id="@+id/screen_verify"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/verify_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:textColor="@color/waygate_ink" />
        <Button
            android:id="@+id/finish_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_finish" />
        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <Button
            android:id="@+id/verify_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_abandon" />
    </LinearLayout>
</LinearLayout>
